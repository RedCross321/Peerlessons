# Публичный адрес сайта без завершающего слэша.
# Используется для canonical, Open Graph, robots.txt, sitemap.xml и llms.txt.
VITE_SITE_URL=https://example.com

# Необязательно: ссылка на репозиторий для llms.txt.
VITE_REPO_URL=https://github.com/USERNAME/Peerlessons

# Cloudflare Turnstile: публичный site key.
# Оставьте пустым, чтобы отключить капчу.
# Тестовый ключ (всегда пропускает, только для локальной разработки):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Необязательно: Sentry для фронтенда.
# DSN можно оставить пустым — тогда Sentry не загружается.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=
